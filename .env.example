# Application
THREAT_AGENT_ENV=demo
THREAT_AGENT_MODE=llm
THREAT_AGENT_DEFAULT_TENANT=default
THREAT_AGENT_DEFAULT_RUN_ID=primary
THREAT_AGENT_DEFAULT_CASE_DIR=cases/c2_malicious
THREAT_AGENT_OUTPUT_DIR=outputs/demo
THREAT_AGENT_LOG_LEVEL=INFO

# Checkpoint and graph
THREAT_AGENT_CHECKPOINT_BACKEND=memory
THREAT_AGENT_CHECKPOINT_PATH=outputs/checkpoints.sqlite
THREAT_AGENT_GRAPH_RECURSION_LIMIT=1000

# Judgment budget
JUDGMENT_MAX_ITERATIONS=30
JUDGMENT_MAX_TOOL_CALLS=60
JUDGMENT_MAX_SCOPE_EXPANSIONS=2
JUDGMENT_MAX_REPAIR_ACTIONS=8
JUDGMENT_MAX_VERDICT_REPAIRS=2

# Response budget
RESPONSE_MAX_ITERATIONS=3

# Evidence query
EVIDENCE_QUERY_DEFAULT_LIMIT=1000
EVIDENCE_QUERY_MAX_LIMIT=5000

# OpenAI-compatible models; credentials intentionally empty
THREAT_AGENT_API_KEY=
THREAT_AGENT_API_BASE=https://api.deepseek.com
JUDGMENT_MODEL_NAME=deepseek-v4-flash
JUDGMENT_MODEL_MAX_TOKENS=4096
JUDGMENT_MODEL_TIMEOUT_SECONDS=60
JUDGMENT_MODEL_MAX_RETRIES=1
JUDGMENT_MODEL_TEMPERATURE=0
RESPONSE_MODEL_NAME=deepseek-v4-flash
RESPONSE_MODEL_MAX_TOKENS=4096
RESPONSE_MODEL_TIMEOUT_SECONDS=60
RESPONSE_MODEL_MAX_RETRIES=1
RESPONSE_MODEL_TEMPERATURE=0
MODEL_CONTEXT_WINDOW_TOKENS=100000

# Reference demo data
DEMO_DATA_STORE_PATH=outputs/demo-reference.sqlite
DEMO_RUNTIME_STORE_PATH=outputs/investigation-runtime.sqlite
DEMO_DATASET_VERSION=2026.08.1
DEMO_DATA_PROFILE=l3-attribution-and-assets
DEMO_RANDOM_SEED=20260811

# Read-only presentation service
THREAT_AGENT_API_HOST=127.0.0.1
THREAT_AGENT_API_PORT=8000

# ============================================================
# 配置原则：.env 只写「与代码默认值的差异」，其余一律省略。
# 全部默认值定义在 bootstrap/settings.py；demo 启动时会打印
# 生效配置摘要（* 标记被覆盖的项），排查时以它为准。
#
# 下面按「什么时候才需要设置」分组，全部注释即为各键默认值。
# ============================================================

# ── 模型服务 ── 换服务商 / 换模型 / 换密钥时设置
#THREAT_AGENT_API_KEY=
#THREAT_AGENT_API_BASE=https://api.deepseek.com
#JUDGMENT_MODEL_NAME=
#RESPONSE_MODEL_NAME=              # 不设则回落 MODEL_NAME
#MODEL_CONTEXT_WINDOW_TOKENS=100000  # 换模型时按其实际上下文窗口调整
#JUDGMENT_MODEL_MAX_TOKENS=512     # 报告是单次长 JSON 输出，通常需要调高
#RESPONSE_MODEL_MAX_TOKENS=512
#JUDGMENT_MODEL_TEMPERATURE=0
#RESPONSE_MODEL_TEMPERATURE=0

# ── 稳定性 ── 内网/网络波动、模型响应慢时设置
#JUDGMENT_MODEL_TIMEOUT_SECONDS=240
#RESPONSE_MODEL_TIMEOUT_SECONDS=240
#JUDGMENT_MODEL_MAX_RETRIES=2
#RESPONSE_MODEL_MAX_RETRIES=2
#MODEL_DISABLE_PROXY=false          # true 时模型请求忽略 HTTP(S)_PROXY 等代理环境变量，
#                                   # 始终直连模型服务；系统代理无法访问模型服务时开启
#MODEL_DISABLE_TLS_VERIFY=false     # true 时跳过模型端点的 TLS 证书校验；自签名证书的内网端点开启

# ── 调查边界与预算 ── 需要更长回看窗口或更大调查预算时设置
#INVESTIGATION_LOOKBACK_HOURS=24   # 告警回看窗口（Feature 13）
#JUDGMENT_MAX_ITERATIONS=30
#JUDGMENT_MAX_TOOL_CALLS=60
#JUDGMENT_MAX_REPORT_REJUDGMENTS=2 # 报告接地重新研判次数（Feature 14）
#RESPONSE_MAX_ITERATIONS=3

# ── 断点恢复 ── 需要调查跨进程恢复时设置
#THREAT_AGENT_CHECKPOINT_BACKEND=sqlite
#THREAT_AGENT_CHECKPOINT_PATH=outputs/checkpoints.sqlite

# ── 演示数据 ── 更换数据集版本、默认数据等级或存储位置时设置
#DEMO_DATA_STORE_PATH=outputs/demo-reference.sqlite
#DEMO_RUNTIME_STORE_PATH=outputs/investigation-runtime.sqlite
#DEMO_DATASET_VERSION=2026.08.1
#DEMO_DATA_PROFILE=l3-attribution-and-assets   # L0-L3 数据等级，影响可见数据源
#DEMO_RANDOM_SEED=20260811

# ── 查询限制 ── 单次查询返回规模
#EVIDENCE_QUERY_DEFAULT_LIMIT=1000
#EVIDENCE_QUERY_MAX_LIMIT=5000

# ── 知识能力 ── 换知识供应方时设置
#KNOWLEDGE_ADAPTER=null            # null | reference | attack
                                   # attack（Feature 18）：ATT&CK 真实语料接管 attack_technique 源，
                                   # 语料由 scripts/build_attack_corpus.py 离线构建，运行时零网络零 LLM
#KNOWLEDGE_ATTACK_CORPUS=corpora/attack_technique.jsonl
#KNOWLEDGE_REFERENCE_PROFILE=standard
#KNOWLEDGE_TIMEOUT_SECONDS=10

# ── 服务 ── 演示页监听地址
#THREAT_AGENT_API_HOST=127.0.0.1
#THREAT_AGENT_API_PORT=8000

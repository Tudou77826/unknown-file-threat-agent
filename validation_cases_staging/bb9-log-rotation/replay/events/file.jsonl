{"event_id": "file-content-rotation-policy.txt", "event_type": "file_content", "domain": "file", "source_system": "file-reader/1", "observed_at": "2026-10-08T19:41:12.342Z", "host_id": "server-01", "subject_refs": ["file:server-01:/opt/tools/cases/rotation-policy.txt"], "data": {"path": "/opt/tools/cases/rotation-policy.txt", "size": 145, "content": "策略：/var/log/applog 下超过 7 天的日志 gzip 归档至 /var/backups/applog/ 后删除原件（运维轮转标准流程）。\n"}}
{"event_id": "file-content-rotate.sh", "event_type": "file_content", "domain": "file", "source_system": "file-reader/1", "observed_at": "2026-10-08T19:41:12.342Z", "host_id": "server-01", "subject_refs": ["file:server-01:/opt/tools/cases/rotate.sh"], "data": {"path": "/opt/tools/cases/rotate.sh", "size": 279, "content": "#!/usr/bin/env bash\nset -euo pipefail\nfind /var/log/applog -name 'app.log.*' -mtime +7 -exec gzip {} \\;\nfind /var/log/applog -name 'app.log.*.gz' -exec mv {} /var/backups/applog/ \\;\nfind /var/log/applog -name 'app.log.*' -mtime +7 -delete 2>/dev/null || true\n"}}

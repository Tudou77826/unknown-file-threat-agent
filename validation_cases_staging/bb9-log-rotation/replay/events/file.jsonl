{"event_id": "file-content-rotation-policy.txt", "event_type": "file_content", "domain": "file", "source_system": "file-reader/1", "observed_at": "2026-10-08T19:41:12.342Z", "host_id": "lab-vm-aliyun-01", "subject_refs": ["file:lab-vm-aliyun-01:/opt/secval-lab/cases/bb9-log-rotation/rotation-policy.txt"], "data": {"path": "/opt/secval-lab/cases/bb9-log-rotation/rotation-policy.txt", "size": 145, "content": "策略：/var/log/secval-demo 下超过 7 天的日志 gzip 归档至 /var/backups/secval-demo/ 后删除原件（运维轮转标准流程）。\n"}}
{"event_id": "file-content-rotate.sh", "event_type": "file_content", "domain": "file", "source_system": "file-reader/1", "observed_at": "2026-10-08T19:41:12.342Z", "host_id": "lab-vm-aliyun-01", "subject_refs": ["file:lab-vm-aliyun-01:/opt/secval-lab/cases/bb9-log-rotation/rotate.sh"], "data": {"path": "/opt/secval-lab/cases/bb9-log-rotation/rotate.sh", "size": 279, "content": "#!/usr/bin/env bash\nset -euo pipefail\nfind /var/log/secval-demo -name 'app.log.*' -mtime +7 -exec gzip {} \\;\nfind /var/log/secval-demo -name 'app.log.*.gz' -exec mv {} /var/backups/secval-demo/ \\;\nfind /var/log/secval-demo -name 'app.log.*' -mtime +7 -delete 2>/dev/null || true\n"}}
